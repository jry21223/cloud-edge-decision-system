LOCAL_CONFIDENCE_THRESHOLD=0.80
CONTROLLER_URL=http://controller:8000
CLOUD_URL=http://toxiproxy:8666
RECORDER_URL=http://recorder:8000
CLOUD_TIMEOUT_MS=800
CLOUD_INFERENCE_DELAY_MS=350
NODE_TTL_SECONDS=15
PEER_ENABLED=true
PEER_TIMEOUT_MS=400
HEARTBEAT_INTERVAL_SECONDS=2
# Set a random value for shared/non-local deployments. Endpoint allowlisting is always enforced.
NODE_REGISTRATION_TOKEN=
ALLOW_TEST_CONTROLS=false
DATABASE_URL=sqlite:////data/metrics.db

# Optional local GGUF edge model. Keep rule mode as the reproducible default.
EDGE_INFERENCE_BACKEND=rule
# EDGE_LLM_MODEL_PATH=/app/models/artifacts/your-model.gguf
EDGE_LLM_CONTEXT=512
EDGE_LLM_GPU_LAYERS=-1
EDGE_LLM_WARM_ON_START=false
