LOCAL_CONFIDENCE_THRESHOLD=0.80
CONTROLLER_URL=http://controller:8000
CLOUD_URL=http://toxiproxy:8666
RECORDER_URL=http://recorder:8000
CLOUD_TIMEOUT_MS=800
CLOUD_INFERENCE_DELAY_MS=350
NODE_TTL_SECONDS=15
# Peer Edge is an optional later extension; the MVP keeps it disabled.
PEER_ENABLED=false
PEER_TIMEOUT_MS=400
HEARTBEAT_INTERVAL_SECONDS=2
# Set a random value for shared/non-local deployments. Endpoint allowlisting is always enforced.
NODE_REGISTRATION_TOKEN=
ALLOW_TEST_CONTROLS=false
DATABASE_URL=sqlite:////data/metrics.db

# Default software simulation. Real Edge mode requires the profile and both ONNX files.
EDGE_VISION_BACKEND=simulation
INDUSTRIAL_VISION_PROFILE=/app/configs/industrial-vision-profile.json
MODEL_ARTIFACTS_DIR=./models/artifacts
# YOLO_ONNX_PATH=/app/models/artifacts/yolo-defects-nms.onnx
# EFFICIENTAD_ONNX_PATH=/app/models/artifacts/efficientad.onnx
YOLO_INPUT_NAME=images
YOLO_OUTPUT_NAME=detections
YOLO_INPUT_SIZE=640
YOLO_SCORE_THRESHOLD=0.50
EFFICIENTAD_INPUT_NAME=images
EFFICIENTAD_SCORE_OUTPUT=anomaly_score
EFFICIENTAD_MAP_OUTPUT=anomaly_map
EFFICIENTAD_INPUT_SIZE=256
EFFICIENTAD_SCORE_THRESHOLD=0.60
EFFICIENTAD_MAP_THRESHOLD=0.60

# Cloud VLM review is optional and fail-closed when selected without all fields.
CLOUD_VISION_BACKEND=simulation
CLOUD_VLM_DATA_EXPORT_APPROVED=false
# CLOUD_VLM_ENDPOINT=https://provider.example/v1/chat/completions
# CLOUD_VLM_MODEL=vision-review-model
# CLOUD_VLM_API_KEY=

# Optional local GGUF edge model. Keep rule mode as the reproducible default.
EDGE_INFERENCE_BACKEND=rule
# EDGE_LLM_MODEL_PATH=/app/models/artifacts/your-model.gguf
EDGE_LLM_CONTEXT=512
EDGE_LLM_GPU_LAYERS=-1
EDGE_LLM_WARM_ON_START=false
